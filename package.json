{
  "name": "newpaper",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "i18n:check": "pnpm --filter @newpaper/i18n run test",
    "tauri": "tauri",
    "dev": "tauri dev",
    "e2e": "pnpm --filter @newpaper/e2e run test"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "typescript": "7.0.2"
  }
}