{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ui",
  "description": "Permisos de la webview de interfaz. Las webviews de contenido no reciben ninguno.",
  "webviews": ["ui"],
  "permissions": [
    "core:default",
    "allow-tab-open", "allow-tab-close", "allow-tab-activate", "allow-tab-navigate",
    "allow-tab-back", "allow-tab-forward", "allow-tab-reload", "allow-tab-set-view",
    "allow-tab-set-bounds", "allow-tabs-snapshot", "allow-chrome-set-theme", "allow-chrome-set-motion", "allow-ctx-close", "allow-ctx-edit", "allow-clipboard-text",
    "allow-settings-get", "allow-settings-set", "allow-settings-list",
    "allow-history-record-visit", "allow-history-record-search", "allow-history-mark-analyzed",
    "allow-history-search", "allow-history-delete", "allow-omnibox-suggest",
    "allow-secret-set", "allow-secret-has", "allow-secret-delete",
    "allow-config-read",
    "allow-privacy-status", "allow-net-set-mode", "allow-tor-set-exit-country", "allow-tor-new-circuit",
    "allow-privacy-set-routing", "allow-tab-without-tor", "allow-adblock-status", "allow-adblock-set-enabled",
    "allow-adblock-set-list", "allow-adblock-refresh", "allow-blocked-counts"
  ]
}
