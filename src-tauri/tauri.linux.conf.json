{
  "bundle": {
    "targets": ["deb", "rpm", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "category": "News",
    "shortDescription": "Private news reader and browser",
    "longDescription": "newpaper reads the news for you: reader view, source coverage and bias analysis, Tor routing and ad blocking.",
    "linux": {
      "deb": {
        "section": "web",
        "depends": ["libwebkit2gtk-4.1-0 (>= 2.40)", "libgtk-3-0", "libdbus-1-3"],
        "recommends": ["gnome-keyring | kwalletmanager | keepassxc"],
        "desktopTemplate": "linux/newpaper.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/newpaper.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
