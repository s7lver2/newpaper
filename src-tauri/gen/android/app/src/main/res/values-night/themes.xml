<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.np_app" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
    </style>

    <!-- Arranque en modo oscuro: la misma tinta que el resto del splash (#17171A, MOVIL-DISENO «Arranque»). -->
